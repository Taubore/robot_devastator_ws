<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo reference="left_chenille">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
  <gazebo reference="right_chenille">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.200</wheel_separation>
      <wheel_radius>0.01966</wheel_radius>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

  <!-- Système requis par tout capteur Gazebo (caméra, lidar, etc.), absent tant qu'aucun
       capteur n'était simulé. -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <!-- Lidar simulé, calqué sur le RPLIDAR A1M8 réel (laser_link, voir capteurs.xacro).
       gz_frame_id force le frame_id publié dans /scan à "laser_link" : sans lui, Gazebo
       Harmonic (gz-sim 8) publie par défaut un nom composé selon la hiérarchie de liens
       (ex. "devastator/base_link/laser_link"), pas le nom du lien seul. -->
  <gazebo reference="laser_link">
    <sensor name="rplidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>laser_link</gz_frame_id>
      <!-- 6,8 Hz : fréquence mesurée sur le RPLIDAR A1M8 réel de ce robot, pas une valeur de
           fiche technique. Sources : docs/inventaire_composantes.md:25,
           docs/decisions_et_lecons.md:263. -->
      <update_rate>6.8</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <!-- 588 = 4000 Hz (taux d'échantillonnage mode standard, fiche technique Slamtec
                 LD108 A1M8, externe au dépôt) / 6,8 Hz (fréquence mesurée ci-dessus). -->
            <samples>588</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- 0,15 m / 12,0 m : valeurs par défaut du pilote officiel rplidar_ros pour l'A1M8,
               non mesurées sur ce robot (non documentées dans docs/ ni README.md). -->
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>