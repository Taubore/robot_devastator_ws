<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Dimensions du châssis (en mètres) -->
  <xacro:property name="chassis_longueur"       value="0.230"/>
  <xacro:property name="chassis_largeur"        value="0.230"/>
  <xacro:property name="chassis_hauteur"        value="0.098"/>
  <xacro:property name="base_link_hauteur_sol"  value="0.082"/>
  <xacro:property name="chassis_z_offset"       value="-0.011"/>
  <xacro:property name="masse_chassis"          value="1.9"/>  

  <!-- Matériaux : définis une seule fois, référencés par nom ensuite -->
  <material name="bleu_fonce">
    <color rgba="0 0 0.3 1.0"/>
  </material>

  <material name="gris">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>

  <!-- Repère sol — aucune géométrie visuelle -->
  <link name="base_footprint"/>

  <!-- Joint fixe entre le sol et l'axe central du robot -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_link_hauteur_sol}" rpy="0 0 0"/>
  </joint>

  <!-- Corps principal : boîte centrée sur base_link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_longueur} ${chassis_largeur} ${chassis_hauteur}"/>
      </geometry>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <material name="bleu_fonce"/>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_longueur} ${chassis_largeur} ${chassis_hauteur}"/>
      </geometry>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="${masse_chassis}"/>
      <inertia
        ixx="${masse_chassis*(chassis_largeur*chassis_largeur+chassis_hauteur*chassis_hauteur)/12}"
        iyy="${masse_chassis*(chassis_longueur*chassis_longueur+chassis_hauteur*chassis_hauteur)/12}"
        izz="${masse_chassis*(chassis_longueur*chassis_longueur+chassis_largeur*chassis_largeur)/12}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

</robot>
